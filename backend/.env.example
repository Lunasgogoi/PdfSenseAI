HF_TOKEN=hf_your_token_here
HOST=0.0.0.0
PORT=8000
UPLOAD_DIR=uploads
VECTOR_STORE_DIR=vector_store
MAX_UPLOAD_MB=25
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=pdfsense
MONGODB_TIMEOUT_MS=5000
JWT_SECRET_KEY=replace_with_at_least_32_random_characters
ACCESS_TOKEN_EXPIRE_MINUTES=10080
AUTH_COOKIE_NAME=pdfsense_session
AUTH_COOKIE_SECURE=false
USER_DOCUMENT_LIMIT=10
USER_DAILY_AI_LIMIT=50
CHAT_HISTORY_LIMIT=100

EMBEDDING_PROVIDER=hf-inference
EMBEDDING_MODEL_NAME=mixedbread-ai/mxbai-embed-large-v1
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=60
RETRIEVAL_DEFAULT_TOP_K=5
RETRIEVAL_MAX_TOP_K=20

GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_TEMPERATURE=0.2
GROQ_MAX_COMPLETION_TOKENS=1024
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=2
RAG_TOP_K=5
SUMMARY_BATCH_CHARACTERS=12000
SUMMARY_INTERMEDIATE_MAX_TOKENS=512
SUMMARY_FINAL_MAX_TOKENS=1536
SUMMARY_MAX_REDUCTION_ROUNDS=8
STUDY_CONTEXT_CHARACTERS=24000
STUDY_MAX_COMPLETION_TOKENS=4096
STUDY_MAX_ITEMS_PER_TYPE=20
